{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttributionResult",
  "type": "object",
  "required": [
    "question_text",
    "student_answer",
    "correct_answer",
    "error_tag",
    "knowledge_id",
    "knowledge_name",
    "confidence",
    "citations"
  ],
  "properties": {
    "question_text": { "type": "string", "minLength": 1 },
    "student_answer": { "type": "string" },
    "correct_answer": { "type": "string" },
    "error_tag": {
      "type": "string",
      "enum": ["概念混淆", "计算错误", "审题偏差", "知识遗忘"]
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^M[0-9]-C[0-9]-K[0-9]+$"
    },
    "knowledge_name": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "marking_trace": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["knowledge_id", "title", "definition", "score"],
        "properties": {
          "knowledge_id": { "type": "string" },
          "title": { "type": "string" },
          "definition": { "type": "string" },
          "common_errors": { "type": "string" },
          "score": { "type": "number" }
        }
      }
    },
    "needs_review": { "type": "boolean" },
    "prompt_version": { "type": "string" }
  }
}
